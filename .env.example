# =============================================================================
# AI Purchasing Agent — environment configuration
#
# Copy to .env.local and fill in whichever ONE provider you have a key for.
#
#   cp .env.example .env.local
#
# Nothing here is required.
#
# If you have the Claude Code CLI installed and signed in, real model reasoning
# works out of the box with no configuration at all. Otherwise add a free
# Gemini key below. With neither, the system still runs end to end on its
# deterministic policy engine — every part of the pipeline except the
# natural-language reasoning — so the demo and the full evaluation suite are
# always runnable.
# =============================================================================


# --- LLM provider ------------------------------------------------------------
# Leave LLM_PROVIDER unset and the system picks one automatically, in this
# order:
#
#   1. whichever API key is set below;
#   2. a locally installed, signed-in Claude Code CLI  (no API key needed);
#   3. deterministic mode.
#
# Set it to "none" to force deterministic mode even if a provider is available.
#
# LLM_PROVIDER=claude-code   # claude-code | gemini | groq | openai | anthropic | none
#
# Verify whichever you choose actually works:   npm run check:llm


# --- Option A: Claude Code CLI bridge (no API key) ---------------------------
# If you already have the Claude Code CLI installed and signed in, the agent
# uses it as its model backend through your existing session — nothing to
# configure, no key to paste, no billing to set up.
#
#   https://claude.com/claude-code
#
# The CLI has no tool-calling API, so the bridge renders the tool catalogue and
# the conversation into a prompt and asks for a JSON tool call back. Claude
# Code's own tools and dynamic system prompt are switched off, so it acts as a
# completion backend rather than as a second agent on your filesystem.
#
# CLAUDE_CODE_MODEL=haiku          # haiku | sonnet | opus — haiku is fastest and cheapest
# CLAUDE_CODE_BIN=/usr/local/bin/claude   # only if `claude` is not on PATH
# CLAUDE_CODE_TIMEOUT_MS=180000
# CLAUDE_CODE_BRIDGE=off           # disable auto-detection of the local CLI


# --- Option B: Google Gemini (free tier) -------------------------------------
# Create a key at https://aistudio.google.com/apikey — no billing required.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash    # or gemini-2.5-flash

# --- Other providers ---------------------------------------------------------
# Groq — has a free tier, OpenAI-compatible.  https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5


# --- Agent behaviour ---------------------------------------------------------

# How many tool-calling rounds the model gets during investigation before the
# orchestrator stops waiting and falls back to the policy engine.
# MAX_INVESTIGATION_STEPS=10

# Per-request timeout for LLM calls, in milliseconds.
# LLM_TIMEOUT_MS=60000


# --- Simulation --------------------------------------------------------------

# The system's "today". Fixed so seeded demand history, forecast windows and
# every evaluation assertion stay reproducible regardless of the real date.
# SIM_TODAY=2026-11-04

# Supplier fault injection. With this on (the default), some suppliers push
# back on orders — most notably SUP-03, which silently confirms only 400 units
# no matter how many are ordered. That fault is what the post-execution
# validation and self-correction logic exist to catch, so leave it on unless
# you specifically want to see the happy path.
# FAULT_INJECTION=on      # on | off

# Where the SQLite file lives.
# DB_PATH=./data/purchasing.db
