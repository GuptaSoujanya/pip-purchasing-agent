{
  "name": "ai-purchasing-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack AI Purchasing Agent: makes, executes and validates purchasing decisions with a closed feedback loop.",
  "scripts": {
    "dev": "npm run db:reset && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx scripts/reset-db.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:llm": "AGENT_MODE=llm tsx scripts/run-eval.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
